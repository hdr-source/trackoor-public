# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_string
DASHBOARD_PASSWORD=pick_any_password

# Where the dashboard lives (used for CORS). Use "*" only in dev.
FRONTEND_URL=http://localhost:3000

# Database — Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/solana_tracker

# Redis (Upstash free tier works fine)
REDIS_URL=redis://default:password@your-upstash-url:6379

# Helius (helius.dev) — used for the enhanced webhook + token metadata
HELIUS_API_KEY=your_helius_api_key
HELIUS_WEBHOOK_SECRET=any_long_random_string
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_URL=https://your-public-backend-url/webhook/helius

# Telegram — bot token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
